---
import ListView from '../../views/ListView.astro';
import { topicName } from '../../lib/i18n';
import { topicPaths } from '../../lib/routes';
import type { Post } from '../../lib/posts';
import type { Topic } from '../../site.config';

export const getStaticPaths = () => topicPaths('ko');

const { topic, posts } = Astro.props as { topic: Topic; posts: Post[] };
---

<ListView
  lang="ko"
  title={topicName('ko', topic)}
  posts={posts}
  path={`topics/${topic}`}
  otherPath={`topics/${topic}`}
  activeTopic={topic}
/>
