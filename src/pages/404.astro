---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href, ui } from '../lib/i18n';

const ko = ui('ko');
const en = ui('en');
---

<BaseLayout lang="ko" title={ko.notFound} noindex>
  <div class="wrap not-found">
    <h1 class="page-title">{ko.notFound}</h1>
    <p class="not-found__body">{ko.notFoundBody}</p>
    <p class="not-found__body" lang="en">{en.notFound}. {en.notFoundBody}</p>
    <ul class="not-found__links">
      <li><a href={href('ko')}>{ko.home}</a></li>
      <li><a href={href('ko', 'posts')}>{ko.allPosts}</a></li>
      <li><a href={href('en')} lang="en">English home</a></li>
    </ul>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-top: 96px;
  }
  .not-found__body {
    margin-top: 12px;
    color: var(--ink-muted);
  }
  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .not-found__links a {
    color: var(--heading);
    text-decoration-color: var(--rule-strong);
  }
  .not-found__links a:hover {
    color: var(--accent);
  }
</style>
