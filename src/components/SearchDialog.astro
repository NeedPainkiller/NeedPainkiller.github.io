---
import Icon from './Icon.astro';
import { asset, ui } from '../lib/i18n';
import type { Lang } from '../site.config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
---

<dialog
  class="search"
  data-search-dialog
  aria-label={t.search}
  data-pagefind={asset('pagefind/pagefind.js')}
  data-base={asset('')}
  data-msg-empty={t.searchEmpty}
  data-msg-idle={t.searchIdle}
  data-msg-unavailable={t.searchUnavailable}
>
  <form class="search__bar" method="dialog" role="search">
    <Icon name="search" size={18} />
    <label class="sr-only" for="search-input">{t.search}</label>
    <input
      id="search-input"
      class="search__input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder={t.searchPlaceholder}
      data-search-input
    />
    <button class="search__close" type="submit" value="close">
      <span class="sr-only">{t.close}</span><kbd aria-hidden="true">Esc</kbd>
    </button>
  </form>
  <p class="search__status" data-search-status aria-live="polite">{t.searchIdle}</p>
  <ol class="search__results" data-search-results></ol>
  <p class="search__hint" aria-hidden="true">{t.searchHint}</p>
</dialog>

<script>
  type PagefindResult = { url: string; excerpt: string; meta: { title?: string } };
  type Pagefind = {
    options: (o: Record<string, unknown>) => Promise<void>;
    init: () => Promise<void>;
    debouncedSearch: (
      q: string,
      o?: Record<string, unknown>,
      ms?: number,
    ) => Promise<{ results: { data: () => Promise<PagefindResult> }[] } | null>;
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
    const list = dialog.querySelector<HTMLOListElement>('[data-search-results]')!;
    const status = dialog.querySelector<HTMLElement>('[data-search-status]')!;
    let pagefind: Pagefind | null = null;
    let loading: Promise<Pagefind | null> | null = null;

    const load = () =>
      (loading ??= import(/* @vite-ignore */ dialog.dataset.pagefind!)
        .then(async (mod: Pagefind) => {
          await mod.options({ baseUrl: dialog.dataset.base, excerptLength: 24 });
          await mod.init();
          pagefind = mod;
          return mod;
        })
        .catch(() => {
          status.textContent = dialog.dataset.msgUnavailable ?? '';
          return null;
        }));

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      input.select();
      void load();
    };

    for (const trigger of document.querySelectorAll('[data-search-open]')) {
      trigger.addEventListener('click', open);
    }

    document.addEventListener('keydown', (event) => {
      const typing = (event.target as HTMLElement).closest('input, textarea, [contenteditable="true"]');
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      } else if (event.key === '/' && !typing && !dialog.open) {
        event.preventDefault();
        open();
      }
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    const links = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];

    const render = (items: PagefindResult[], query: string) => {
      list.replaceChildren(
        ...items.map((item) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.className = 'search__result';
          a.href = item.url;
          const title = document.createElement('span');
          title.className = 'search__title';
          title.textContent = item.meta.title ?? item.url;
          const excerpt = document.createElement('span');
          excerpt.className = 'search__excerpt';
          excerpt.innerHTML = item.excerpt; // Pagefind escapes content and only adds <mark>
          a.append(title, excerpt);
          li.append(a);
          return li;
        }),
      );
      status.textContent = items.length ? '' : `${dialog.dataset.msgEmpty} “${query}”`;
    };

    input.addEventListener('input', async () => {
      const query = input.value.trim();
      if (!query) {
        list.replaceChildren();
        status.textContent = dialog.dataset.msgIdle ?? '';
        return;
      }
      const pf = pagefind ?? (await load());
      if (!pf) return;
      const search = await pf.debouncedSearch(query, {}, 140);
      if (!search) return;
      const items = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
      if (input.value.trim() === query) render(items, query);
    });

    dialog.addEventListener('keydown', (event) => {
      // A search input swallows the first Escape to clear itself; the hint promises Esc closes.
      if (event.key === 'Escape') {
        event.preventDefault();
        dialog.close();
        return;
      }
      const all = links();
      if (!all.length) return;
      const index = all.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        all[Math.min(index + 1, all.length - 1)]!.focus();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (index <= 0) input.focus();
        else all[index - 1]!.focus();
      } else if (event.key === 'Enter' && document.activeElement === input) {
        event.preventDefault();
        all[0]!.click();
      }
    });
  }
</script>

<style>
  .search {
    width: min(600px, calc(100vw - 32px));
    max-height: min(560px, calc(100dvh - 120px));
    margin: min(96px, 10vh) auto auto;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: 12px;
    background: var(--bg-raised);
    color: var(--ink);
    box-shadow: var(--shadow-dialog);
    overflow: hidden;
  }
  .search[open] {
    display: flex;
    flex-direction: column;
    animation: search-in 220ms var(--ease-out);
  }
  .search::backdrop {
    background: var(--scrim);
    animation: scrim-in 220ms var(--ease-out);
  }
  @keyframes search-in {
    from {
      opacity: 0;
      translate: 0 10px;
      scale: 0.985;
    }
  }
  @keyframes scrim-in {
    from {
      opacity: 0;
    }
  }

  .search__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 12px 0 18px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-faint);
  }
  .search__input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--heading);
    font: inherit;
    font-size: 17px;
  }
  .search__input::placeholder {
    color: var(--ink-faint);
  }
  .search__input::-webkit-search-cancel-button {
    display: none;
  }
  .search__close {
    padding: 4px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .search__close kbd {
    padding: 2px 6px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--bg-subtle);
    color: var(--ink-muted);
    font-size: 11.5px;
  }
  .search__status:not(:empty) {
    padding: 18px 18px 6px;
    font-size: 14px;
    color: var(--ink-faint);
  }
  .search__results {
    list-style: none;
    margin: 0;
    padding: 6px;
    overflow-y: auto;
  }
  .search__results:empty {
    display: none;
  }
  /* Results are created by script, so they carry no scoped-style attribute: style them globally. */
  .search__results :global(.search__result) {
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    outline-offset: -2px;
  }
  .search__results :global(.search__result:hover),
  .search__results :global(.search__result:focus-visible) {
    background: var(--bg-subtle);
  }
  .search__results :global(.search__title) {
    font-size: 15px;
    font-weight: 600;
    color: var(--heading);
  }
  .search__results :global(.search__excerpt) {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search__results :global(.search__excerpt mark) {
    background: var(--mark);
    color: var(--heading);
    border-radius: 3px;
    padding: 0 0.1em;
  }
  .search__hint {
    margin: 0;
    padding: 10px 18px;
    border-top: 1px solid var(--rule);
    font-size: 12px;
    color: var(--ink-faint);
  }
  @media (max-width: 640px) {
    .search {
      margin-top: 16px;
    }
    .search__hint {
      display: none;
    }
  }
</style>
